# Новый NestJS-бэкенд (Monetikum-new/backend) ещё не заскаффолжен — Фаза 1
# временно работает через тестовый инстанс СТАРОГО backend (monetikum-backend).
# API_URL — реальный адрес, используется напрямую в серверных запросах (serverFetch),
# там нет CORS-ограничений браузера.
API_URL=https://test.monetikum.ru/api

# NEXT_PUBLIC_API_URL — same-origin путь для браузерных запросов ($api/axios).
# Реальный адрес подставляет rewrites() в next.config.ts (проксирует через
# Next.js-сервер), чтобы браузер не упирался в CORS у test.monetikum.ru.
NEXT_PUBLIC_API_URL=/api/proxy

# Секрет для шифрования next-auth JWT-сессии (в т.ч. Sanctum session-cookie/
# XSRF-токена test.monetikum.ru, которые живут только внутри неё — см.
# src/shared/config/auth.ts). AUTH_SECRET — актуальное имя в next-auth v5,
# NEXTAUTH_SECRET поддерживается как алиас для обратной совместимости.
# Сгенерировать: npx auth secret (или openssl rand -base64 33).
AUTH_SECRET=
